# Образец окружения для `deployments/prod/docker-compose.yml`.
#
#   cp .env.example .env    # и заполнить значения
#
# Файл `.env` в репозиторий не коммитится (см. .gitignore). Значения берите из
# секрет-менеджера; здесь они намеренно пустые, чтобы забытую подстановку было
# видно сразу — сервис не стартует без AUTH_PROXY_SECRET и AUTH_TOTP_SECRET.

# Версия образа. Пин на конкретную версию вместо latest: иначе `docker compose
# pull` молча подтянет новый мажор.
JWT_SERVICE_VERSION=1.13.4

# Базовый URL сервиса ключей (jwks-service-app).
JWKS_SERVICE_URL=http://jwks-service-app:8080

# --- Секреты уровней доступа -------------------------------------------------

# Уровень 2. Тот же секрет прописывается обратному прокси, который ставит
# заголовок X-Proxy-Secret и ОБЯЗАН затирать клиентскую версию заголовка.
AUTH_PROXY_SECRET=

# Уровень 3. Base32 без паддинга, тот же секрет у клиентов.
AUTH_TOTP_SECRET=

# Второй активный секрет на время ротации: выкатывается сюда, клиенты
# переезжают, потом становится основным. Пусто — ротация не идёт.
AUTH_TOTP_SECRET_NEXT=

# Уровень 4. Bearer-токен для скрейпа /metrics. Пусто — ручка не публикуется
# (404), сервис при этом стартует нормально.
AUTH_METRICS_TOKEN=

# --- Сеть --------------------------------------------------------------------

# Доверенные прокси (IP/CIDR через запятую): только их X-Forwarded-For
# принимается как адрес клиента. Дефолт совпадает с подсетью docker-сети из
# compose-файла. Прокси вне этой сети (на хосте, отдельным стендом) — добавьте
# его адрес сюда, иначе per-IP лимит будет общим на всех клиентов.
RATE_LIMIT_TRUSTED_PROXIES=172.31.0.0/16

# --- Наблюдаемость -----------------------------------------------------------

LOG_FORMAT=json
RUST_LOG=jwt_service_app=info

GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=prod

# Базовый URL OTLP-коллектора, напр. http://otel-collector:4318. Пусто —
# трейсинг выключен.
OTEL_EXPORTER_OTLP_ENDPOINT=
