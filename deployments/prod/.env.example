# A sample environment for `deployments/prod/docker-compose.yml`.
#
#   cp .env.example .env    # and fill in the values
#
# The `.env` file is not committed (see .gitignore). Take the values from a
# secret manager; they are deliberately empty here so that a forgotten
# substitution is visible at once — the service does not start without
# AUTH_PROXY_SECRET and AUTH_TOTP_SECRET.

# The image version. Pinned to a specific version instead of latest: otherwise
# `docker compose pull` silently picks up a new major.
JWT_SERVICE_VERSION=1.13.4

# The base URL of the key service (jwks-service-app).
JWKS_SERVICE_URL=http://jwks-service-app:8080

# --- Tokens ------------------------------------------------------------------

# The domains acceptable in the `iss` claim (the value of the Host header),
# comma-separated, for example: jwt.example.com,api.example.com. Empty means any
# Host, as before. Fill it in when this instance and its neighbours talk to the
# same jwks-service-app: the shared key makes a token issued here with someone
# else's `iss` valid at the neighbour.
TOKEN_ISSUER_ALLOWLIST=

# --- Access level secrets ----------------------------------------------------

# Level 2. The same secret is configured on the reverse proxy, which sets the
# X-Proxy-Secret header and MUST strip the client-supplied version of it.
AUTH_PROXY_SECRET=

# Level 3. Base32 without padding, the same secret as on the clients.
AUTH_TOTP_SECRET=

# A second active secret for the duration of a rotation: it is rolled out here,
# the clients move over, and then it becomes the primary one. Empty means no
# rotation is in progress.
AUTH_TOTP_SECRET_NEXT=

# Level 4. The bearer token for scraping /metrics. Empty means the endpoint is
# not published (404) while the service still starts normally.
AUTH_METRICS_TOKEN=

# --- HTTP server --------------------------------------------------------------

# The number of worker threads. Empty or `auto` means from the container's CPU
# quota; without a quota (`cpus` is not set in the compose file) the default
# ceiling is used rather than the host core count. Set an explicit number when
# you want to pin memory consumption to a known number of workers.
SERVER_WORKERS=

# The time allowed to receive the request headers (ms) and the idle time of a
# keep-alive connection (s). A zero in either removes the corresponding limit —
# do not do that when the service is reachable other than through the reverse
# proxy: a slow client will hold a worker.
SERVER_CLIENT_REQUEST_TIMEOUT_MS=5000
SERVER_KEEP_ALIVE_SECONDS=5
# The time allowed to drain requests on shutdown. It must be strictly less than
# the container's stop_grace_period (30 s in docker-compose.yml).
SERVER_SHUTDOWN_TIMEOUT_SECONDS=25

# --- Network -----------------------------------------------------------------

# The trusted proxies (IP/CIDR, comma-separated): only their X-Forwarded-For is
# accepted as the client address. The default matches the docker network subnet
# from the compose file. For a proxy outside that network (on the host, or as a
# separate stand) add its address here, or the per-IP limit becomes shared by
# every client.
RATE_LIMIT_TRUSTED_PROXIES=172.31.0.0/16

# --- Observability -----------------------------------------------------------

LOG_FORMAT=json
RUST_LOG=jwt_service_app=info

GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=prod

# The base URL of the OTLP collector, e.g. http://otel-collector:4318. Empty
# means tracing is off.
OTEL_EXPORTER_OTLP_ENDPOINT=
