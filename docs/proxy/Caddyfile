# Caddy — the secret comes from the environment through {env.PROXY_SECRET}.
# header_up with "-" deletes the header, then set applies the secret.

api.example.com {
    reverse_proxy jwt_service:8080 {
        # (1) Delete the client-supplied version of the header.
        header_up -X-Proxy-Secret
        # (2) Set the secret from the environment (an overwrite, as the header is already gone).
        header_up X-Proxy-Secret {env.PROXY_SECRET}
    }
}
