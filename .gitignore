/target
/.idea

# The maintainer's local working notes. Never committed.
AGENTS_INTERNAL.md

# Artifacts of a load run: the issued tokens and the k6 export.
# The tokens are real signed JWTs and have no place in the repository.
/deployments/load/tokens.json
/deployments/load/summary.json

# The production environment: filled-in access level secrets. Only the samples
# are committed — .env.example and k8s/secret.example.yaml.
/deployments/prod/.env
/deployments/prod/k8s/secret.yaml

# macOS Finder litter: it appears in any folder that is opened and has nothing
# to do with the repository. No leading slash — at any depth, not just the root.
.DS_Store